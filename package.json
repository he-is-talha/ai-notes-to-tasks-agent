{
  "name": "ai-notes-to-tasks-agent",
  "version": "0.1.0",
  "description": "Two-tool agent that turns standup notes into tasks with dry-run and audit log",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "notes-to-tasks": "node --env-file=.env --import tsx src/cli.ts",
    "demo:dry-run": "npm run notes-to-tasks -- --notes samples/messy-notes.md",
    "demo:execute": "npm run notes-to-tasks -- --execute --notes samples/messy-notes.md",
    "pull-model": "./scripts/pull-model.sh"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "zod": "^4.4.3"
  }
}
