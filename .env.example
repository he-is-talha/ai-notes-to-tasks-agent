LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
ADAPTER=sqlite
SQLITE_PATH=data/tasks.db
# Demo default for samples/messy-notes.md (tests still use 6 via code default / overrides)
MAX_TOOL_CALLS=40

